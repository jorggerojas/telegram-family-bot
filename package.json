{
	"name": "telegram-family-bot",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
		"cf-typegen": "wrangler types",
		"lint": "biome check src test scripts migrations package.json tsconfig.json vitest.config.mts wrangler.jsonc",
		"lint:ci": "biome ci src test scripts migrations package.json tsconfig.json vitest.config.mts wrangler.jsonc",
		"format": "biome format --write src test scripts migrations package.json tsconfig.json vitest.config.mts wrangler.jsonc",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"telegram:ids": "node scripts/telegram-ids.mjs",
		"webhook:set": "node scripts/webhook-set.mjs",
		"webhook:info": "node scripts/webhook-info.mjs",
		"oauth:start": "node scripts/oauth-start.mjs",
		"commitlint": "commitlint",
		"prepare": "husky",
		"gga": "gga run || exit 1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@cloudflare/vitest-plugin": "^1.0.0",
		"@commitlint/cli": "21.2.3",
		"@commitlint/config-conventional": "21.2.3",
		"@types/node": "^26.6.4",
		"husky": "9.1.7",
		"lint-staged": "17.0.7",
		"typescript": "^5.5.2",
		"vitest": "~4.1.0",
		"wrangler": "^4.149.0"
	},
	"lint-staged": {
		"*.{js,ts,tsx,jsx,json,css,mjs}": [
			"biome check --write --error-on-warnings --files-ignore-unknown=true"
		]
	},
	"dependencies": {
		"grammy": "^1.46.0",
		"groq-sdk": "^1.6.0",
		"openai": "^7.32.0",
		"zod": "^4.6.5"
	}
}
