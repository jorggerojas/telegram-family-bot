/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Personal deployment values (D1 database_id, calendar ID, Worker URL) belong
 * in ignored local secrets / a local wrangler override — never commit them.
 *
 * D1: omit database_id and let Wrangler auto-provision on deploy, or set it in a
 * gitignored wrangler.local.jsonc after `wrangler d1 create`.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "telegram-family-bot",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "telegram-family-bot"
		}
	],
	/**
	 * Non-secret defaults can live in .dev.vars for local development.
	 * Calendar ID and Worker URL are secrets so each deploy stays private.
	 */
	"secrets": {
		"required": [
			"TELEGRAM_BOT_TOKEN",
			"TELEGRAM_WEBHOOK_SECRET",
			"GEMINI_API_KEY",
			"GOOGLE_CLIENT_ID",
			"GOOGLE_CLIENT_SECRET",
			"GOOGLE_TOKEN_ENCRYPTION_KEY",
			"OAUTH_SETUP_ADMIN_TOKEN",
			"ALLOWED_TELEGRAM_USERS_JSON",
			"GOOGLE_CALENDAR_ID",
			"WORKER_BASE_URL"
		]
	}
}
